@*
    社員一覧画面
*@

@model IEnumerable<EmployeeManagement.Web.Applications.Domains.Employee>

@{
    ViewData["Title"] = "社員一覧";
}

<div class="container mt-5">

    <h2 class="mb-4">
        @ViewData["Title"]
    </h2>

    <!-- ボタン -->
    <div class="mb-3">

        <a asp-action="Create"
           class="btn btn-primary">

            追加

        </a>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-secondary">

            戻る

        </a>

    </div>

    <!-- 検索 -->
    <form asp-action="Index"
          method="get"
          class="mb-3">

        <div class="input-group">

            <input type="text"
                   name="keyword"
                   value="@ViewBag.Keyword"
                   class="form-control"
                   placeholder="社員番号・氏名・部門名・メールアドレスで検索" />

            <button type="submit"
                    class="btn btn-primary">

                検索

            </button>

            <a asp-action="Index"
               class="btn btn-secondary">

                クリア

            </a>

        </div>

    </form>

    <!-- 一覧 -->
    <table class="table table-bordered table-striped">

        <thead class="table-dark">

            <tr>

                <th>社員番号</th>
                <th>氏名</th>
                <th>氏名(ふりがな)</th>
                <th>部門名</th>
                <th>メールアドレス</th>
                <th>生年月日</th>
                <th>性別</th>
                <th>操作</th>

            </tr>

        </thead>

        <tbody>

            @foreach (var employee in Model)
            {
                <tr>

                    <td>
                        @employee.EmployeeNo
                    </td>

                    <td>
                        @employee.Name
                    </td>

                    <td>
                        @employee.NameKana
                    </td>

                    <td>
                        @employee.DepartmentName
                    </td>

                    <td>
                        @employee.EmailAddress
                    </td>

                    <td>
                        @employee.Birthday.ToString("yyyy/MM/dd")
                    </td>

                    <td>

                        @if (employee.Gender == 1)
                        {
                            <span>男</span>
                        }
                        else
                        {
                            <span>女</span>
                        }

                    </td>

                    <td>

                        <a asp-action="Edit"
                           asp-route-id="@employee.Id"
                           class="btn btn-warning btn-sm">

                            編集

                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@employee.Id"
                           class="btn btn-danger btn-sm">

                            削除

                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>