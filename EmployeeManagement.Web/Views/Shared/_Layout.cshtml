@{
    var loginEmployeeName =
        Context.Session.GetString("LoginEmployeeName");
}

<!DOCTYPE html>
<html lang="ja">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - 社員情報管理システム
    </title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/EmployeeManagement.Web.styles.css"
          asp-append-version="true" />

</head>

<body>

    <!-- ヘッダー -->
    <header>

        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4">

            <div class="container-fluid">

                <!-- システム名 -->
                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    社員情報管理システム

                </a>

                <!-- ログイン後メニュー -->
                @if (!string.IsNullOrEmpty(loginEmployeeName))
                {
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                        <ul class="navbar-nav flex-grow-1">

                            <li class="nav-item">

                                <a class="nav-link text-white"
                                   asp-controller="Employee"
                                   asp-action="Index">

                                    社員一覧

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link text-white"
                                   asp-controller="Department"
                                   asp-action="Index">

                                    部門一覧

                                </a>

                            </li>

                        </ul>

                        <!-- ログインユーザー -->
                        <div class="d-flex align-items-center">

                            <span class="text-white me-3">

                                @loginEmployeeName さん

                            </span>

                            <!-- ログアウト -->
                            <form asp-controller="Login"
                                  asp-action="Logout"
                                  method="post">

                                <button type="submit"
                                        class="btn btn-outline-light btn-sm">

                                    ログアウト

                                </button>

                            </form>

                        </div>

                    </div>
                }

            </div>

        </nav>

    </header>

    <!-- メイン -->
    <div class="container">

        <main role="main"
              class="pb-3">

            @RenderBody()

        </main>

    </div>

    <!-- フッター -->
    <footer class="border-top footer text-muted">

        <div class="container">

            &copy; 2026 - EmployeeManagement.Web

        </div>

    </footer>

    <!-- Script -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>